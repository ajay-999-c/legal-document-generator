# Python bytecode, caches, and test reports
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local virtual environments
.venv/
venv/
env/
.build-venv/
.venv-*/

# Internal working notes: keep locally, exclude from the published source
/CODEX_PHASE1_IMPLEMENTATION_PLAN.md
/IMPLEMENTATION_NOTES.md
/local-notes/
/.agents/
/.codex/

# Secrets and private runtime configuration
credentials.json
*credentials*.json
*service-account*.json
*service_account*.json
*serviceaccount*.json
secrets/
.secrets/
.streamlit/secrets.toml
.env
.env.*
*.pem
*.key
*.p12
*.pfx
config.yaml
config.yml
config.yaml.tmp
config.yml.tmp
!config.example.yaml
!config.example.yml

# Generated output; retain intentional empty-directory placeholders
**/generated/*
!**/generated/.gitkeep
**/output/*
!**/output/.gitkeep
*.docx
*.pdf
# Application Word templates are source assets, including legacy templates
!**/templates/**/*.docx
!**/template/**/*.docx

# Temporary renders, previews, and runtime logs
preview/
previews/
render/
renders/
rendered/
render_output/
tmp_render*/
.render*/
tmp/
temp/
logs/
*.log
*.log.*
*.tmp
*.temp
~$*

# Python packaging, builds, and installers (keep build scripts)
build/
dist/
*.spec
*.egg-info/
.eggs/
*.egg
*.whl
*.exe
*.msi
*.msix
*.app/
*.dmg
*.pkg
*.deb
*.rpm

# OS and local editor settings
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Reviewed Windows build specification
!legal_document_generator.spec
